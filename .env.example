# Copy to server/.env and adjust as needed.

PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/signup-and-login
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# Production: set CLIENT_ORIGIN to your Vercel URL, e.g.
# CLIENT_ORIGIN=https://order-and-settlement-task.vercel.app
# NODE_ENV=production

# Copy to client/.env and adjust as needed.
# Used as the API base URL in the browser (and as the Vite proxy target in dev).
VITE_SERVER_ORIGIN=http://localhost:5001

# Production (Vercel Project → Environment Variables, then redeploy):
# VITE_SERVER_ORIGIN=https://YOUR-API-HOST
# Do NOT use localhost here — the user's browser cannot reach your laptop.

